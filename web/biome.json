{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!dist-e2e-*",
      "!dev-dist",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!src/styles/tokens.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "warn", "noExplicitAny": "error" },
      "security": { "noDangerouslySetInnerHtml": "error" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
