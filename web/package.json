    "@size-limit/file": "^14.1.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "happy-dom": "^20.14.5",
    "size-limit": "^14.1.0",
