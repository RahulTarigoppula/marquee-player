{
  "format": "marquee.cue-sheet.v1",
  "cues": [
    { "id": "playPause",      "keys": ["Space"],              "action": "Play / pause" },
    { "id": "back5",          "keys": ["ArrowLeft"],          "action": "Back 5 s (hold to keep going)" },
    { "id": "forward5",       "keys": ["ArrowRight"],         "action": "Forward 5 s (hold to keep going)" },
    { "id": "back30",         "keys": ["Shift+ArrowLeft"],    "action": "Back 30 s" },
    { "id": "forward30",      "keys": ["Shift+ArrowRight"],   "action": "Forward 30 s" },
    { "id": "percentSeek",    "keys": ["0-9"],                "action": "Jump to 0 %–90 % of the film" },
    { "id": "volumeUp",       "keys": ["ArrowUp"],            "action": "Volume up (to 150 %)" },
    { "id": "volumeDown",     "keys": ["ArrowDown"],          "action": "Volume down" },
    { "id": "mute",           "keys": ["M"],                  "action": "Mute / unmute" },
    { "id": "nextFile",       "keys": ["N"],                  "action": "Next film in the folder" },
    { "id": "previousFile",   "keys": ["P"],                  "action": "Previous film in the folder" },
    { "id": "syncEarlier",    "keys": ["J"],                  "action": "Subtitles 50 ms earlier" },
    { "id": "syncLater",      "keys": ["K"],                  "action": "Subtitles 50 ms later" },
    { "id": "syncEarlierBig", "keys": ["Shift+J"],            "action": "Subtitles 500 ms earlier" },
    { "id": "syncLaterBig",   "keys": ["Shift+K"],            "action": "Subtitles 500 ms later" },
    { "id": "frameBack",      "keys": [","],                  "action": "Previous frame" },
    { "id": "frameForward",   "keys": ["."],                  "action": "Next frame" },
    { "id": "abLoop",         "keys": ["L"],                  "action": "A–B loop: set A, set B, clear" },
    { "id": "slower",         "keys": ["["],                  "action": "Slower (pitch-corrected)" },
    { "id": "faster",         "keys": ["]"],                  "action": "Faster (pitch-corrected)" },
    { "id": "fullscreen",     "keys": ["F"],                  "action": "Fullscreen (or double-click the picture)" },
    { "id": "subtitleTracks", "keys": ["S"],                  "action": "Subtitle booth" },
    { "id": "audioTracks",    "keys": ["A"],                  "action": "Next audio track" },
    { "id": "openFile",       "keys": ["Ctrl+O"],             "action": "Open a film" },
    { "id": "mediaKeys",      "keys": ["MediaPlayPause", "MediaTrackNext", "MediaTrackPrevious"], "action": "Media keys: play / pause, next, previous film" },
    { "id": "cueSheet",       "keys": ["?"],                  "action": "This cue sheet" },
    { "id": "back",           "keys": ["Escape"],             "action": "Back one lighting state (fullscreen first)" }
  ]
}
