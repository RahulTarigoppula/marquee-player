<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Everything absent from this list is absent on purpose (IMPLEMENTATION-PROMPT §8.2): no
         camera, no location, no notifications, no exact alarms, no MANAGE_EXTERNAL_STORAGE, no
         network-state snooping. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- keep-screen-on during playback (wakelock_plus) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- MediaStore library scan only. SAF ("Open with", the file picker) needs NONE of these. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- No READ_MEDIA_AUDIO: Marquee is a video player with no audio-library feature.
         PLAN 4.1, DESIGN §14 and TESTING M-F3 all list the video permission only. If an
         "external audio track" feature ever lands, add it back here WITH the feature named,
         and add the matching row to TESTING §14. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                     android:maxSdkVersion="32" />

    <application
        android:label="Marquee"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale|navigation|keyboard">
            <!-- configChanges is load-bearing: without orientation|screenSize|smallestScreenSize|
                 screenLayout Android recreates the Activity on rotation (and on entering PiP),
                 which restarts libmpv and loses the frame mid-film. -->

            <meta-data android:name="io.flutter.embedding.android.NormalTheme"
                       android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" from Files, a browser download, or any file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- containers Android does not map to video/* -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Share sheet -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Don't delete: the Flutter tool uses it to generate GeneratedPluginRegistrant.java -->
        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>

    <!-- Package visibility for the engine's text-selection "Process text" menu
         (io.flutter.plugin.text.ProcessTextPlugin). Declares no permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
