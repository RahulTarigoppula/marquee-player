<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: #07060A with the lit bulb and a 300 ms warm-up.
         values-night-v31 repeats this file because the night qualifier outranks the API level
         when resources are resolved. NormalTheme is inherited from values/ (or values-night/). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/marquee_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_bulb</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/marquee_bg</item>
        <item name="android:navigationBarColor">@color/marquee_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
